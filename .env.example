# Public, build-time values (Vite exposes only VITE_* to the browser).
# Never put secrets here — everything below ends up in the shipped JavaScript.

# Production domain, no trailing slash. Used for canonical URLs, sitemap, Open Graph.
VITE_SITE_URL=https://example.com

# Form backend endpoint (Formspree, Web3Forms, Getform, your own API...). Receives JSON via POST.
VITE_FORM_ENDPOINT=

# Optional: public access key for services like Web3Forms (public by design).
VITE_FORM_ACCESS_KEY=
